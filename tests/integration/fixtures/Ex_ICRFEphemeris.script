%  Minimal LEO mission used by the OEM round-trip integration tests to
%  exercise the EarthICRF coordinate-system path through the writer. Mirrors
%  Ex_LEOEphemeris (EarthMJ2000Eq) so the two fixtures together cover both
%  branches of the writer's frame-alias table on real GMAT-emitted output.
%  Avoids OpenFramesInterface / OrbitView so it parses headlessly through
%  gmatpy. 6-hour propagation interpolated onto 60 s ephemeris cadence ->
%  361 records.

Create Spacecraft Sat
Sat.DateFormat = UTCGregorian
Sat.Epoch = '01 Jan 2026 12:00:00.000'
Sat.CoordinateSystem = EarthICRF
Sat.DisplayStateType = Keplerian
Sat.SMA = 7000
Sat.ECC = 0.001
Sat.INC = 28.5
Sat.RAAN = 75
Sat.AOP = 90
Sat.TA = 0

Create ForceModel FM
FM.CentralBody = Earth
FM.PrimaryBodies = {Earth}

Create Propagator Prop
Prop.FM = FM
Prop.Type = PrinceDormand78
Prop.InitialStepSize = 60
Prop.Accuracy = 1e-9

Create EphemerisFile EF
EF.Spacecraft = Sat
EF.Filename = 'icrf_ephemeris.oem'
EF.FileFormat = CCSDS-OEM
EF.EpochFormat = UTCGregorian
EF.CoordinateSystem = EarthICRF
EF.WriteEphemeris = true
EF.StepSize = 60

BeginMissionSequence
Propagate Prop(Sat) {Sat.ElapsedSecs = 21600}
